# For same-origin monorepo deployment (frontend + backend on same host), keep '/'.
# Example external API value: https://api.example.com/
VITE_API_BASE_URL=http://localhost:5001/
# Create a FormSubmit form and use its email or invisible-form token here.
VITE_FORMSUBMIT_ENDPOINT=https://formsubmit.co/your-team-email@example.com
