{
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/house/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/reservations/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/trips/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/ai/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/coupons/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/reviews/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/chat/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/loyalty/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/notifications/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}